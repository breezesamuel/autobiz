a.org/wiki/Hoofdpagina&lt;/base&gt; &lt;generator&gt;MediaWiki 1.40.0-wmf.3&lt;/generator&gt; &lt;case&gt;first-letter&lt;/case&gt; &lt;namespaces&gt; &lt;namespace key=&quot;-2&quot; case=&quot;first-letter&quot;&gt;Media&lt;/namespace&gt; &lt;namespace key=&quot;-1&quot; case=&quot;first-letter&quot;&gt;Speciaal&lt;/namespace&gt; &lt;namespace key=&quot;0&quot; case=&quot;first-letter&quot; /&gt; &lt;namespace key=&quot;1&quot; case=&quot;first-letter&quot;&gt;Overleg&lt;/namespace&gt; &lt;namespace key=&quot;2&quot; case=&quot;first-letter&quot;&gt;Gebruiker&lt;/namespace&gt; &lt;namespace key=&quot;3&quot; case=&quot;first-letter&quot;&gt;Overleg gebruiker&lt;/namespace&gt; &lt;namespace key=&quot;4&quot; case=&quot;first-letter&quot;&gt;Wikipedia&lt;/namespace&gt; &lt;namespace key=&quot;5&quot; case=&quot;first-letter&quot;&gt;Overleg Wikipedia&lt;/namespace&gt; &lt;namespace key=&quot;6&quot; case=&quot;first-letter&quot;&gt;Bestand&lt;/namespace&gt; &lt;namespace key=&quot;7&quot; case=&quot;first-letter&quot;&gt;Overleg bestand&lt;/namespace&gt; &lt;namespace key=&quot;8&quot; case=&quot;first-letter&quot;&gt;MediaWiki&lt;/namespace&gt; &lt;namespace key=&quot;9&quot; case=&quot;first-letter&quot;&gt;Overleg MediaWiki&lt;/namespace&gt; &lt;namespace key=&quot;10&quot; case=&quot;first-letter&quot;&gt;Sjabloon&lt;/namespace&gt; &lt;namespace key=&quot;11&quot; case=&quot;first-letter&quot;&gt;Overleg sjabloon&lt;/namespace&gt; &lt;namespace key=&quot;12&quot; case=&quot;first-letter&quot;&gt;Help&lt;/namespace&gt; &lt;namespace key=&quot;13&quot; case=&quot;first-letter&quot;&gt;Overleg help&lt;/namespace&gt; &lt;namespace key=&quot;14&quot; case=&quot;first-letter&quot;&gt;Categorie&lt;/namespace&gt; &lt;namespace key=&quot;15&quot; case=&quot;first-letter&quot;&gt;Overleg categorie&lt;/namespace&gt; &lt;namespace key=&quot;100&quot; case=&quot;first-letter&quot;&gt;Portaal&lt;/namespace&gt; &lt;namespace key=&quot;101&quot; case=&quot;first-letter&quot;&gt