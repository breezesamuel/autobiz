t; &lt;li&gt;{{ $answer-&gt;answer1 }}&lt;/li&gt; &lt;li&gt;{{ $answer-&gt;answer2 }}&lt;/li&gt; &lt;li&gt;{{ $answer-&gt;answer3 }}&lt;/li&gt; &lt;li&gt;{{ $answer-&gt;answer4 }}&lt;/li&gt; &lt;li&gt;{{ $answer-&gt;answer5 }}&lt;/li&gt; &lt;/ul&gt; &lt;/div&gt; @endforeach {{-- &lt;div class=&quot;card-body&quot;&gt; &lt;ul class=&quot;list-unstyled&quot;&gt; &lt;li&gt;&lt;p&gt;Exceptional Node skills using JavaScript&lt;/p&gt;&lt;/li&gt; &lt;li&gt;&lt;p&gt;Part of team for the development of the backend components of all Bitfinex Services&lt;/p&gt;&lt;/li&gt; &lt;li&gt;&lt;p&gt;Good experience in interacting with databases&lt;/p&gt;&lt;/li&gt; &lt;li&gt;&lt;p&gt;Good understanding of security practices&lt;/p&gt;&lt;/li&gt; &lt;li&gt;&lt;p&gt;Familiar with microservices architecture&lt;/p&gt;&lt;/li&gt; &lt;/ul&gt; &lt;/div&gt; --}} &lt;/div&gt; &lt;/div&gt; &lt;/div&gt; &lt;/div&gt; @endsection",
