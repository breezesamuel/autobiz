# ===== 收款通道 =====
# PayPal REST 应用凭据 (https://developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# live = 真实收款, sandbox = 沙盒测试
PAYPAL_MODE=live

# MoltsPay (x402/CDP 协议) https://moltspay.com/docs/dev-guide/
MOLTSPAY_API_KEY=
MOLTSPAY_SECRET=

# ===== AI 文本处理（OpenAI 兼容接口，三选一即可）=====
# 智谱: https://open.bigmodel.cn  -> https://open.bigmodel.cn/api/paas/v4
# Ollama(本地): http://localhost:11434/v1
# Agnes AI / 其他 OpenAI 兼容网关: 填对应 base_url
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== 可选：提高抓取配额 =====
GITHUB_TOKEN=
